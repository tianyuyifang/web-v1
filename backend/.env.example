PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/music_app
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d
MP3_BASE_PATH=/path/to/music/allSongs
CLIPS_BASE_PATH=/path/to/music/allClips
FRONTEND_URL=http://localhost:3000

# Encrypts users' own QQ / NetEase cookies at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it costs every stored credential — users just reconnect — so it is
# deliberately not derived from anything a database dump would carry.
MUSIC_VAULT_KEY=
