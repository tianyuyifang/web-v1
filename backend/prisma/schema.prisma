generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PENDING
  MEMBER
  ADMIN
}

enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  username        String     @unique
  passwordHash    String     @map("password_hash")
  role            Role       @default(PENDING)
  preferences     Json?      @default("{}") @db.JsonB
  activeSessionId String?    @map("active_session_id") @db.Uuid
  deviceLimit     Int?       @map("device_limit")
  activeSessions  Json?      @default("[]") @map("active_sessions") @db.JsonB
  expiresAt       DateTime?  @map("expires_at") @db.Timestamptz
  monthlyFee      Decimal?   @map("monthly_fee") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus? @map("payment_status")
  billingNotes    String?    @map("billing_notes")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  playlists        Playlist[]
  clips            Clip[]
  likes            Like[]
  captureSessions  CaptureSession[]
  sharedPlaylists  PlaylistShare[]
  copyPermissions  PlaylistCopyPermission[]
  feedback         Feedback[]
  bandwidthLogs    BandwidthLog[]

  @@map("users")
}

model Song {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String
  artist               String
  duration             Int?
  filePath             String   @map("file_path")
  lyrics               String?
  starts               String?

  titlePinyin          String?  @map("title_pinyin")
  titlePinyinInitials  String?  @map("title_pinyin_initials")
  titlePinyinConcat    String?  @map("title_pinyin_concat")
  titlePinyinAll       String?  @map("title_pinyin_all")
  titlePinyinInitialsAll String? @map("title_pinyin_initials_all")
  artistPinyin         String?  @map("artist_pinyin")
  artistPinyinInitials String?  @map("artist_pinyin_initials")
  artistPinyinConcat   String?  @map("artist_pinyin_concat")
  artistPinyinAll      String?  @map("artist_pinyin_all")
  artistPinyinInitialsAll String? @map("artist_pinyin_initials_all")

  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  songArtists          SongArtist[]
  clips                Clip[]

  @@index([titlePinyinInitials])
  @@index([titlePinyinConcat])
  @@map("songs")
}

model SongArtist {
  id                   String @id @default(uuid()) @db.Uuid
  songId               String @map("song_id") @db.Uuid
  artistName           String @map("artist_name")
  artistPinyin         String? @map("artist_pinyin")
  artistPinyinInitials String? @map("artist_pinyin_initials")
  artistPinyinConcat   String? @map("artist_pinyin_concat")
  artistPinyinAll      String? @map("artist_pinyin_all")
  artistPinyinInitialsAll String? @map("artist_pinyin_initials_all")
  position             Int    @default(0)

  song                 Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@map("song_artists")
}

model Clip {
  id        String   @id @default(uuid()) @db.Uuid
  songId    String   @map("song_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  start     Int
  length    Int      @default(20)
  filePath  String?  @map("file_path")
  lyrics    String?
  isGlobal  Boolean  @default(true) @map("is_global")
  version   Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  song          Song           @relation(fields: [songId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  playlistClips PlaylistClip[]
  likes         Like[]
  captureEvents CaptureEvent[]

  @@index([songId, userId])
  @@index([songId, start])
  @@map("clips")
}

model Playlist {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  description         String?
  isPublic            Boolean  @default(false) @map("is_public")

  namePinyin          String?  @map("name_pinyin")
  namePinyinInitials  String?  @map("name_pinyin_initials")
  namePinyinAll       String?  @map("name_pinyin_all")

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistClips       PlaylistClip[]
  likes               Like[]
  captureSessions     CaptureSession[]
  shares              PlaylistShare[]
  copyPermissions     PlaylistCopyPermission[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistShare {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@map("playlist_shares")
}

model PlaylistCopyPermission {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@map("playlist_copy_permissions")
}

model PlaylistClip {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  clipId     String   @map("clip_id") @db.Uuid
  position   Int

  speed        Float    @default(1.0)
  pitch        Int      @default(0)
  colorTag     String?  @map("color_tag")
  comment      String?
  sectionLabel String?  @map("section_label")

  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([playlistId, clipId])
  @@index([clipId])
  @@index([playlistId, position], map: "idx_playlist_clips_playlist_position")
  @@map("playlist_clips")
}

model Like {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  clipId     String   @map("clip_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([playlistId, clipId])
  @@index([playlistId])
  @@map("likes")
}

model BandwidthLog {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  date   DateTime @db.Date
  bytes  BigInt   @default(0)

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("bandwidth_logs")
}

enum FeedbackType {
  BAD_SONG
  REQUEST_SONG
  GENERAL
}

enum UpdateCategory {
  FEATURE
  FIX
  ANNOUNCEMENT
  SONG_UPDATE
}

model Update {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  body          String
  category      UpdateCategory @default(ANNOUNCEMENT)
  isHighlighted Boolean        @default(false) @map("is_highlighted")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([createdAt])
  @@map("updates")
}

model Feedback {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      FeedbackType
  title     String?
  artist    String?
  message   String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
}

/// A capture run: the user opens a playlist, starts capture, and closes it when done.
/// The session carries the playlistId, so the capture client only ever sends text —
/// it never names a playlist and cannot write to the wrong one.
model CaptureSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  playlistId String    @map("playlist_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  /// Last time the capture client posted. Null means it has never connected —
  /// the UI needs that to tell "emulator not running" apart from "nothing
  /// captured yet", which otherwise look identical.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist Playlist       @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  events   CaptureEvent[]

  @@index([userId])
  @@index([playlistId])
  @@map("capture_sessions")
}

/// One captured string and what we resolved it to.
///
/// outcome:
///   pending   - matched a single song, waiting for the user to approve
///   ambiguous - several songs share this title; user picks one
///   no_match  - title not in the library
///   duplicate - same rawText already handled in this session
///   approved  - user approved; the like has been applied
///   ignored   - user dismissed it
///
/// Nothing is liked automatically. The user approves each match by hand.
model CaptureEvent {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  rawText       String   @map("raw_text")
  matchedClipId String?  @map("matched_clip_id") @db.Uuid
  candidates    Json?    @db.JsonB
  outcome       String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz

  session CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clip    Clip?          @relation(fields: [matchedClipId], references: [id], onDelete: SetNull)

  /// Dedupe key: the same song is read ~15 times while it sits on screen,
  /// and the string is byte-identical each time, so one row per session+text.
  @@unique([sessionId, rawText])
  @@index([sessionId, createdAt])
  @@map("capture_events")
}
