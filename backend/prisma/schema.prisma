generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // Cannot log in. Where expired guests and lapsed members land, and where an
  // admin can put anyone manually.
  PENDING
  // Signs up and is in straight away, on a short leash: at most three own
  // playlists, cannot publish them, and cannot let anyone copy them. Sharing
  // is allowed — it lets teammates like and auto-tag without moving anything.
  GUEST
  MEMBER
  ADMIN
}

enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  username        String     @unique
  passwordHash    String     @map("password_hash")
  role            Role       @default(PENDING)
  preferences     Json?      @default("{}") @db.JsonB
  activeSessionId String?    @map("active_session_id") @db.Uuid
  deviceLimit     Int?       @map("device_limit")
  activeSessions  Json?      @default("[]") @map("active_sessions") @db.JsonB
  expiresAt       DateTime?  @map("expires_at") @db.Timestamptz
  // Set when an admin revokes a MEMBER back to PENDING, cleared on approval.
  // Without it a revoked member and a brand-new signup are indistinguishable:
  // both are simply PENDING.
  demotedAt       DateTime?  @map("demoted_at") @db.Timestamptz
  // What the user was before landing in PENDING. A guest whose trial ran out
  // and a member who stopped paying both end up PENDING but need different
  // wording, and the role alone cannot tell them apart.
  previousRole    Role?      @map("previous_role")
  // Paid add-ons this user holds, e.g. ["capture"]. Since membership tiers
  // arrived this is a per-user OVERRIDE, not the primary source: a non-empty
  // list wins, an empty list defers to the tier's add-ons. Guests get every
  // add-on free, so this only ever matters for members.
  entitlements    String[]   @default([])
  // Which membership tier this user holds (normal / vip / super_vip / zhiyou),
  // or null for accounts that predate tiers or never got one. The tier decides
  // add-ons and device limit from its editable config; a per-user override
  // (entitlements above, deviceLimit below) still wins when set.
  tier            String?    @map("tier")
  /// Lets this user approve song mappings. A flag rather than a role because
  /// it cuts across the existing ladder: it is granted to a couple of trusted
  /// people, and every ADMIN has it implicitly. One wrong approval is
  /// site-wide, so it stays narrow by default.
  canEditMapping  Boolean    @default(false) @map("can_edit_mapping")
  monthlyFee      Decimal?   @map("monthly_fee") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus? @map("payment_status")
  billingNotes    String?    @map("billing_notes")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  playlists        Playlist[]
  clips            Clip[]
  likes            Like[]
  tagEvents        TagEvent[]
  captureSessions  CaptureSession[]
  sharedPlaylists  PlaylistShare[]
  copyPermissions  PlaylistCopyPermission[]
  feedback         Feedback[]
  bandwidthLogs    BandwidthLog[]
  approvedMappings SongMapping[] @relation("MappingApprover")
  songPrefs        SongPref[]

  @@map("users")
}

/// Site-wide settings an admin changes at runtime, one row per key. A table
/// rather than env vars because these are toggled during normal operation:
/// an env change needs a deploy and a restart, which makes the site owner
/// depend on a developer to both start and stop a campaign.
model Setting {
  key       String   @id
  /// Shape depends on the key — see the SETTINGS map in settingsService.
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model Song {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String
  artist               String
  duration             Int?
  filePath             String   @map("file_path")
  lyrics               String?
  starts               String?

  titlePinyin          String?  @map("title_pinyin")
  titlePinyinInitials  String?  @map("title_pinyin_initials")
  titlePinyinConcat    String?  @map("title_pinyin_concat")
  titlePinyinAll       String?  @map("title_pinyin_all")
  titlePinyinInitialsAll String? @map("title_pinyin_initials_all")
  artistPinyin         String?  @map("artist_pinyin")
  artistPinyinInitials String?  @map("artist_pinyin_initials")
  artistPinyinConcat   String?  @map("artist_pinyin_concat")
  artistPinyinAll      String?  @map("artist_pinyin_all")
  artistPinyinInitialsAll String? @map("artist_pinyin_initials_all")

  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  songArtists          SongArtist[]
  clips                Clip[]

  @@index([titlePinyinInitials])
  @@index([titlePinyinConcat])
  @@map("songs")
}

model SongArtist {
  id                   String @id @default(uuid()) @db.Uuid
  songId               String @map("song_id") @db.Uuid
  artistName           String @map("artist_name")
  artistPinyin         String? @map("artist_pinyin")
  artistPinyinInitials String? @map("artist_pinyin_initials")
  artistPinyinConcat   String? @map("artist_pinyin_concat")
  artistPinyinAll      String? @map("artist_pinyin_all")
  artistPinyinInitialsAll String? @map("artist_pinyin_initials_all")
  position             Int    @default(0)

  song                 Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@map("song_artists")
}

model Clip {
  id        String   @id @default(uuid()) @db.Uuid
  songId    String   @map("song_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  start     Int
  length    Int      @default(20)
  filePath  String?  @map("file_path")
  lyrics    String?
  isGlobal  Boolean  @default(true) @map("is_global")
  version   Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  song          Song           @relation(fields: [songId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  playlistClips PlaylistClip[]
  likes         Like[]
  captureEvents CaptureEvent[]

  @@index([songId, userId])
  @@index([songId, start])
  @@map("clips")
}

model Playlist {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  description         String?
  isPublic            Boolean  @default(false) @map("is_public")

  namePinyin          String?  @map("name_pinyin")
  namePinyinInitials  String?  @map("name_pinyin_initials")
  namePinyinAll       String?  @map("name_pinyin_all")

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistClips       PlaylistClip[]
  likes               Like[]
  captureSessions     CaptureSession[]
  shares              PlaylistShare[]
  copyPermissions     PlaylistCopyPermission[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistShare {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@map("playlist_shares")
}

model PlaylistCopyPermission {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@map("playlist_copy_permissions")
}

model PlaylistClip {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  clipId     String   @map("clip_id") @db.Uuid
  position   Int

  speed        Float    @default(1.0)
  pitch        Int      @default(0)
  colorTag     String?  @map("color_tag")
  comment      String?
  sectionLabel String?  @map("section_label")

  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([playlistId, clipId])
  @@index([clipId])
  @@index([playlistId, position], map: "idx_playlist_clips_playlist_position")
  @@map("playlist_clips")
}

model Like {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  clipId     String   @map("clip_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([playlistId, clipId])
  @@index([playlistId])
  @@map("likes")
}

/// One act of tagging a song, kept whatever happens to the like afterwards.
///
/// `likes` answers "is this clip marked right now", which is what a playlist
/// renders from — so unliking deletes the row and clearing a playlist deletes
/// all of them. That makes it useless for "how much is this person using the
/// site": one singer had tagged 3,704 songs in ten days and had 188 likes left,
/// because tagging a set and clearing it afterwards is the normal way to play.
/// The people using it most were the ones whose history vanished fastest.
///
/// So this is an append-only log of the act. Tagging the same song again the
/// next night writes another row on purpose: it happened twice.
///
/// No foreign key to clip or playlist. Both are on purpose: deleting a song
/// must not erase the fact that someone once tagged it, and the ids are kept
/// only so a future question ("which songs get tagged most") stays answerable.
/// userId does cascade — a deleted account should take its history with it.
model TagEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  clipId     String   @map("clip_id") @db.Uuid
  /// Whether 自动打标 wrote this or the singer pressed it. Both count as
  /// tagging; the split is worth keeping because it says which way they work.
  auto       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The admin view asks "who tagged, and when", newest first, per user.
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("tag_events")
}

model BandwidthLog {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  date   DateTime @db.Date
  bytes  BigInt   @default(0)

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("bandwidth_logs")
}

enum FeedbackType {
  BAD_SONG
  REQUEST_SONG
  GENERAL
}

enum UpdateCategory {
  FEATURE
  FIX
  ANNOUNCEMENT
  SONG_UPDATE
}

model Update {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  body          String
  category      UpdateCategory @default(ANNOUNCEMENT)
  isHighlighted Boolean        @default(false) @map("is_highlighted")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([createdAt])
  @@map("updates")
}

model Feedback {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      FeedbackType
  title     String?
  artist    String?
  message   String?
  /// What an admin wrote back. Its presence is also the status: replied means
  /// dealt with, absent means not yet. A separate status column would have to
  /// be kept in step with this one, and almost every request here is a song
  /// request whose answer is one sentence anyway.
  reply     String?
  repliedAt DateTime?    @map("replied_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
}

/// A capture run: the user opens a playlist, starts capture, and closes it when done.
/// The session carries the playlistId, so the capture client only ever sends text —
/// it never names a playlist and cannot write to the wrong one.
model CaptureSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Null for live (唱卡) sessions, which resolve songs against the mapping
  /// table rather than liking them into a list.
  playlistId String?   @map("playlist_id") @db.Uuid
  /// "playlist" (歌 P, the original short-code flow) or "live" (唱卡).
  /// Decided by the page the user started from, not by the client -- the
  /// APK learns it from the heartbeat response.
  mode       String    @default("playlist")
  /// Where captures currently go: "none" | "playlist" | "live".
  ///
  /// Separate from the token, which is what lets one connection outlive a
  /// change of destination -- the user types the pairing code once a game
  /// rather than once per playlist. "none" means connected but not yet
  /// delivering, and captures arriving then are dropped on purpose.
  target     String    @default("none")
  tokenHash  String    @unique @map("token_hash")
  /// Short code the user types into the capture client to fetch the real
  /// token. The website and the client live in separate worlds (browser on
  /// the PC, APK inside the emulator) with no shared clipboard, so the long
  /// token can never be handed over directly. Cleared once redeemed.
  pairCode   String?   @unique @map("pair_code")
  pairExpiresAt DateTime? @map("pair_expires_at") @db.Timestamptz
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  /// Last time the capture client posted. Null means it has never connected —
  /// the UI needs that to tell "emulator not running" apart from "nothing
  /// captured yet", which otherwise look identical.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz
  /// Which build of the capture client is on the other end.
  ///
  /// Nothing recorded this, so a report of odd behaviour could not be checked
  /// against the version it came from — every diagnosis started by asking the
  /// user, or by guessing. The client sends it on the heartbeat it already
  /// makes, so this costs no extra request.
  ///
  /// Null until a build that reports it connects, which is what makes an old
  /// client identifiable at all.
  clientVersion Int? @map("client_version")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist Playlist?      @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  events   CaptureEvent[]

  @@index([userId])
  @@index([playlistId])
  @@map("capture_sessions")
}

/// One captured string and what we resolved it to.
///
/// outcome:
///   pending   - matched a single song, waiting for the user to approve
///   ambiguous - several songs share this title; user picks one
///   no_match  - title not in the library
///   duplicate - same rawText already handled in this session
///   approved  - user approved; the like has been applied
///   ignored   - user dismissed it
///
/// Nothing is liked automatically. The user approves each match by hand.
model CaptureEvent {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  rawText       String   @map("raw_text")
  matchedClipId String?  @map("matched_clip_id") @db.Uuid
  /// Which playlist this capture was made for, fixed at capture time.
  ///
  /// Not read from the session at approval time: a connection is aimed and
  /// re-aimed while it runs, so the session answers "where are captures going
  /// now" rather than "where did this one come from". Null for 唱卡 captures,
  /// which are never liked anywhere.
  playlistId    String?  @map("playlist_id") @db.Uuid
  /// The words on screen while this song was being sung, as the game showed
  /// them -- lines may be shuffled, partly masked with underscores, or simply
  /// misspelled, so they are stored verbatim and reconciled against real
  /// lyrics elsewhere.
  lyric         String?
  /// Which screen this came from: "picking" (the songs on offer) or
  /// "singing" (the one being performed). Null for captures made before the
  /// client reported it.
  stage         String?
  /// Which round of songs this capture belongs to, as the client saw it.
  ///
  /// De-duplication wants the round that offered the song, and until a client
  /// reported one there was nothing to key on: gaps within a round and gaps
  /// between rounds are both 25-35 seconds, so a time window can only
  /// approximate it. Deriving the round from `stage` was tried and does not
  /// work — the picking/singing judgement flickers within a single round, and
  /// splitting on it cut 339 captures into 69 "rounds", many of them zero
  /// seconds long.
  ///
  /// Null for every build that predates this, which is why it stays optional
  /// and why the time window has to remain as the fallback.
  batchId       String?  @map("batch_id")
  candidates    Json?    @db.JsonB
  outcome       String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz

  session CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clip    Clip?          @relation(fields: [matchedClipId], references: [id], onDelete: SetNull)

  /// Dedupe lookup: the same song is read ~15 times while it sits on screen,
  /// and the string is byte-identical each time. Scoped to the destination as
  /// well as the connection -- a connection now spans several playlists, and
  /// keying on it alone answered "duplicate" for the same song in a second
  /// playlist, which silently never got tagged.
  ///
  /// An index, not a constraint. It was unique until the 唱卡 dedupe gained a
  /// time window: a song offered again in a later round is a new card, and a
  /// unique key on these four columns refuses to store it however the service
  /// decides. Uniqueness now lives in one place -- the lookup in ingestLive and
  /// ingestText -- rather than in two that can disagree.
  ///
  /// ⚠ This declaration does not describe the index that actually exists. The
  /// real one is expression-based (COALESCE over the nullable playlist and
  /// stage, so 唱卡 rows dedupe at all) and is named capture_events_dedupe_lookup;
  /// Prisma cannot express that, so this line stands in for it and has never
  /// matched. `migrate dev` will offer to create a second, redundant index --
  /// decline it. `migrate deploy`, which is what the deploy actually runs, only
  /// applies the migration files and is unaffected.
  @@index([sessionId, playlistId, stage, rawText])
  @@index([sessionId, createdAt])
  @@index([playlistId])
  @@map("capture_events")
}

/// Where a song's audio comes from. The local library is NOT a shortcut that
/// wins by default — it is one source among three, chosen per song when the
/// mapping is approved. Local costs our bandwidth (3-5 MB a play) while the
/// platforms cost none, so external is preferred and local is reserved for
/// songs the platforms cannot serve.
/// One singer's settled preferences for one recording: the key they sing it
/// in, the tempo they want, a note to themselves, and colour flags.
///
/// Keyed on the platform recording (source + external id) rather than on the
/// game song, so the key follows the voice: the same recording reached from a
/// different game title, or after a mapping is repointed at it, is still the
/// same performance to sing. The cost of that choice is the mirror of its
/// benefit -- repointing a mapping to a different recording leaves the old
/// preference behind on the old one, which is right when the two recordings
/// are in different keys and merely untidy when they are not.
///
/// A table rather than another key inside User.preferences. That column already
/// carries the theme and the encrypted platform cookies, and PostgreSQL rewrites
/// an entire jsonb value on every update: measured here at 24x the write-ahead
/// log per change (6,268 bytes against 257), crossing the 2 kB TOAST threshold
/// at around twenty saved songs. Rows are cheap by comparison -- 146 bytes
/// measured all-in, so every capture user keeping 300 songs costs 2.3 MB.
model SongPref {
  userId     String     @map("user_id") @db.Uuid
  source     SongSource
  /// Song UUID when source is LOCAL, else the platform's id. Deliberately a
  /// plain string, matching SongMapping: the three id spaces have nothing in
  /// common and a foreign key would only fit one of them.
  externalId String     @map("external_id")

  /// Semitones, -6..+6, clamped by the player. Nullable and meaningful at 0:
  /// a singer who tries +2 and settles back on the original has decided
  /// something, and storing that is different from never having tried.
  pitch      Int?
  /// Playback rate, 0.5..2.0. Nullable and meaningful at 1.0, as above.
  speed      Float?
  /// A note to oneself, shown on the collapsed card.
  note       String?
  /// Pipe-separated hex colours, the same shape PlaylistClip uses, so one
  /// palette component serves both.
  colorTag   String?    @map("color_tag")

  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup is always "this user, these recordings on screen", so the
  /// primary key serves it directly and no second index is needed.
  @@id([userId, source, externalId])
  @@map("song_prefs")
}

enum SongSource {
  LOCAL
  QQ
  NETEASE
}

/// Game title+artist → one playable id. The heart of the live-cards feature.
///
/// Keyed on what the GAME shows, which is not always what the platform shows:
/// the game says 奢香夫人/凤凰传奇 where QQ says 奢香夫人/玲花_曾毅. Once the
/// mapping exists the platform's own artist string is irrelevant to playback —
/// it is kept only so a human reviewing the row can eyeball it.
///
/// The artist is part of the key, never an attribute: 致青春/王菲 and
/// 致青春/李宇春 are different songs that must not collide. Nothing may look a
/// mapping up by title alone.
///
/// Exactly one source per song, and no automatic fallback: whatever is
/// approved is what plays. A failure surfaces as an explicit reason (needs
/// VIP, cookie expired, delisted) rather than silently sliding to another
/// platform, which would make "why did this play the wrong version" unanswerable.
model SongMapping {
  id           String     @id @default(uuid()) @db.Uuid

  /// Normalised game-side key. Both are lowercased/width-folded; artists are
  /// split, sorted and rejoined so 汪苏泷/赵露思 and 赵露思/汪苏泷 are one key.
  /// The raw forms are kept beside them for display and for re-normalising if
  /// the rules ever change.
  titleKey     String     @map("title_key")
  artistKey    String     @map("artist_key")
  rawTitle     String     @map("raw_title")
  rawArtist    String     @map("raw_artist")

  source       SongSource
  /// Song UUID when source is LOCAL, else the platform's own id (QQ songmid,
  /// NetEase numeric id). Deliberately a plain string: the three id spaces have
  /// nothing in common and a foreign key would only fit one of them.
  externalId   String     @map("external_id")

  /// What the platform calls this song. Display-only — see the note above.
  platformTitle  String?  @map("platform_title")
  platformArtist String?  @map("platform_artist")
  /// Seconds. The cheapest way to tell same-titled versions apart (studio vs
  /// live vs cover), so it is worth storing even though playback ignores it.
  durationSec  Int?       @map("duration_sec")

  /// Approved rows are frozen: automatic search will neither overwrite nor
  /// re-search them. That freeze is the whole point — it is what makes lookups
  /// stop hitting the platforms, which is what keeps us out of rate limiting.
  approved     Boolean    @default(false)
  /// import | search — how the row first appeared. Shown as a tag in review;
  /// once approved it stops mattering, so it is not a separate review bucket.
  origin       String     @default("search")
  /// exact | title-only | fuzzy. Why the importer believed this match. Drives
  /// review ordering: exact self-approves, the rest queue up for a human.
  matchKind    String?    @map("match_kind")
  /// Rejected alternatives, kept so review can offer them without searching
  /// again: [{ source, externalId, title, artist, durationSec }]
  candidates   Json?      @db.JsonB
  note         String?

  approvedById String?    @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?  @map("approved_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  approvedBy   User?      @relation("MappingApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  /// One mapping per game song. Title alone is never unique — see the header.
  @@unique([titleKey, artistKey])
  /// Review queue: "unapproved first, newest first".
  @@index([approved, createdAt])
  /// Lets the importer find every row it could fill from one platform.
  @@index([source])
  @@map("song_mappings")
}

/// Tracks pulled from a QQ/NetEase playlist the admin trusts, waiting to be
/// claimed by a game song.
///
/// Kept apart from SongMapping because the two are different populations: an
/// imported track has a platform-side title/artist and no game key yet, and
/// plenty of them will never be seen in a game at all. Merging them would mean
/// half-populated mapping rows that no lookup can use. A row here graduates
/// into a SongMapping the moment a game song matches it.
model ImportedTrack {
  id           String     @id @default(uuid()) @db.Uuid
  source       SongSource
  externalId   String     @map("external_id")

  title        String
  artist       String
  /// Same normalisation as SongMapping, so matching is an indexed lookup
  /// rather than a scan over every imported row.
  titleKey     String     @map("title_key")
  artistKey    String     @map("artist_key")
  durationSec  Int?       @map("duration_sec")
  album        String?
  /// True when the platform marks this as VIP-only (QQ pay_play=1, NetEase
  /// fee=1). Lets review predict "this will not play" before anyone tries.
  vipOnly      Boolean    @default(false) @map("vip_only")

  /// Which playlist it came from, for tracing a bad batch back to its source.
  playlistRef  String?    @map("playlist_ref")
  /// Set once a game song claims this track — the "seen in play" flag that
  /// makes the review page's coverage counter meaningful.
  matchedAt    DateTime?  @map("matched_at") @db.Timestamptz

  /// The platform's lyrics, fetched once and kept.
  ///
  /// Stored rather than cached because the lyric request carries no credential
  /// at all: it leaves as the server, over the one IP every user shares, and
  /// these platforms rate-limit by address. Measured at 7.2 requests a second
  /// sustained with nothing in the way — so the fix is to stop asking, not to
  /// ask more politely. An in-memory cache would not do: a restart empties it
  /// and every open card goes back to the platform at once.
  ///
  /// Cheap to keep. A lyric measured ~2KB, so the whole catalogue is about
  /// 6MB raw and a third of that once TOAST compresses it.
  lyric        String?    @db.Text
  /// When the lyric was last fetched — including when the answer was "none".
  ///
  /// Without this a song the platform has no words for is indistinguishable
  /// from one never asked about, so every instrumental would be re-fetched
  /// forever. Null means never asked.
  lyricFetchedAt DateTime? @map("lyric_fetched_at") @db.Timestamptz

  /// The same words with a time on every syllable, when the platform has them.
  ///
  /// Normalised on the way in rather than stored raw, because the two sources
  /// disagree about everything except the information: QQ sends encrypted QRC
  /// where the timing follows the text, NetEase sends YRC where it precedes
  /// it. Keeping either shape would put that difference in front of the
  /// player, which cares only about when each syllable starts.
  ///
  /// Separate from `lyric` rather than replacing it. Line-level lyrics exist
  /// for effectively everything and word-level do not, so the fallback has to
  /// remain — and the karaoke sweep is the only thing that needs this, while
  /// everything else reads the plain one it always did.
  wordLyric      String?   @map("word_lyric") @db.Text
  /// When word-level lyrics were last asked for, answered or not.
  ///
  /// Its own clock, because it is asked for separately and much later: the
  /// catalogue was fetched line-by-line long before this existed, so sharing
  /// `lyricFetchedAt` would make every one of those rows look as though it had
  /// already been asked.
  wordLyricFetchedAt DateTime? @map("word_lyric_fetched_at") @db.Timestamptz

  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  /// Re-importing the same playlist updates rows instead of duplicating them.
  @@unique([source, externalId])
  /// The importer's hot path: given a game song, find candidates.
  @@index([titleKey, artistKey])
  @@index([titleKey])
  @@map("imported_tracks")
}

/// An artist whose own name contains a dash, added by hand.
///
/// The split between "歌名-歌手" is made at a dash, so a dash inside the
/// artist's own name is the one thing that can break it: "幸福了然后呢-A-Lin"
/// came apart as "幸福了然后呢-A" / "Lin". Almost every such name is found in
/// imported_tracks and needs no help. This table is for the ones that are not:
/// where the game credits a group and the platform credits the member, the
/// name never appears in the catalogue to be found.
///
/// Kept here rather than corrected in the catalogue because the importer
/// upserts artist from the platform on every run — an edited row reads
/// correctly until the next import and then silently reverts.
///
/// One member per row, never a collaboration. A single member carrying the
/// dash is enough to settle where the dash belongs, so "IN-K" covers every
/// pairing IN-K will ever appear in, in any order.
model DashedArtist {
  id        String   @id @default(uuid()) @db.Uuid
  /// Lowercase, matching how the derived entries are compared.
  name      String   @unique
  /// Why this one needed adding — the catalogue cannot explain itself.
  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("dashed_artists")
}

/// A verified answer for one passage of game lyrics: which real lyric lines it
/// covers.
///
/// The matcher in LiveLyrics.js does well on what it can see — measured at 91%
/// of lines placed — and the remainder is not a tuning problem. It is that the
/// game and the platform break lines differently: the game's 「那个傻瓜说的傻话」
/// is the platform's 「那个傻瓜」 plus 「说的傻话」, and 「对和错」「都不必太在乎」
/// are one platform line split in two. Reading that takes understanding the
/// words, not comparing characters, so the answers are worked out once and kept
/// here rather than recomputed.
///
/// Only checked answers live here. An algorithm result is never written back:
/// storing an unverified guess would freeze a mistake in place, which is worse
/// than not storing it at all. Anything absent — or pending, or unmatchable —
/// falls through to the matcher, so the page can only ever be as good as it is
/// now, never worse.
model LyricPassageMatch {
  id          String     @id @default(uuid()) @db.Uuid

  /// Which recording, named the same way SongMapping names it. Deliberately no
  /// foreign key: a mapping can be repointed or deleted, but this answer is
  /// about a passage of THIS platform song, and it stays true as long as some
  /// mapping still points there.
  source      SongSource
  externalId  String     @map("external_id")

  /// SHA-1 (first 16 chars) of the game's passage, verbatim.
  ///
  /// Shuffled order and different masking make different hashes on purpose. The
  /// answer is an array parallel to the game's own lines, so reordering the
  /// lines invalidates it — and a differently-masked read carries different
  /// evidence, which can deserve a different answer. Measured cost of keeping
  /// them apart: 1.25x the rows (6909 against 5526), which is not worth the
  /// bookkeeping needed to merge them.
  lyricHash   String     @map("lyric_hash")

  /// The passage as the game showed it. The hash cannot be reversed, and review
  /// has to display what was actually on screen.
  gameLyric   String     @map("game_lyric")

  /// One real-lyric line index per game line, in the game's order; -1 where a
  /// line genuinely has no counterpart. Length must equal the game's line count
  /// — the importer refuses anything else.
  answer      Json       @db.JsonB

  /// approved   — checked and trusted; the page uses it.
  /// pending    — a suggestion the reviewer has not confirmed; the page ignores
  ///              it and runs the matcher, so an uncertain guess costs nothing.
  /// unmatchable— the platform holds a different version of the words (a 粤语
  ///              lyric under a 国语 recording, say). No answer exists, and
  ///              saying so stops it being offered for review again. Usually a
  ///              sign the mapping itself wants revisiting.
  status      String     @default("pending")

  /// ai — worked out by the assistant; human — a reviewer's own answer. A human
  /// answer outranks an ai one and is never overwritten by a later pass.
  verifiedBy  String     @map("verified_by")
  /// Why this answer, or why no answer. Free text, shown in review.
  note        String?

  /// How many times a singer pressed 「段落点不准确」 on this passage. The
  /// review queue sorts by it, and an approved row it keeps counting on is
  /// flagged rather than demoted — a stray tap must not undo a human answer.
  /// Reset to 0 when a reviewer changes the answer or the status.
  /// Distinct people, not taps: reporters are recorded below and a repeat
  /// report from the same person is silently ignored, so 3 here means three
  /// different singers found the marks wrong — a far stronger signal.
  reportCount    Int       @default(0) @map("report_count")
  lastReportedAt DateTime? @map("last_reported_at") @db.Timestamptz
  /// Who reported: [{id, name}], deduped by id, capped at 50. Names are
  /// snapshots for the reviewer's tooltip; the id is what dedupes. Shown only
  /// behind requireMappingEditor. Pre-existing counts have no names — the
  /// panel says so rather than pretending.
  reporters      Json      @default("[]") @db.JsonB

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  /// The lookup, and the uniqueness rule: one answer per passage of one song.
  @@unique([source, externalId, lyricHash])
  /// Review queue: pending first, most-seen songs first.
  @@index([status])
  @@map("lyric_passage_matches")
}
